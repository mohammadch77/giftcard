# Copy to .env (never commit .env). Values below are PLACEHOLDERS, not real secrets.
# Validated at boot by src/platform/config/env.ts — the process refuses to start if invalid.

NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# PostgreSQL (application role: DML only once Phase 2b grants exist)
DATABASE_URL=postgresql://giftcard_app:CHANGE_ME@localhost:5432/giftcard
DATABASE_POOL_MAX=10

# Migrations run with a separate, DDL-capable role. Falls back to DATABASE_URL if unset (dev only).
MIGRATION_DATABASE_URL=postgresql://giftcard_migrator:CHANGE_ME@localhost:5432/giftcard

# Test harness only: an admin connection able to CREATE/DROP throwaway databases.
# Never point this at a real/production server.
TEST_DATABASE_ADMIN_URL=postgresql://postgres:CHANGE_ME@localhost:5432/postgres

# External providers are NOT selected yet (decisions D3-D5). Allowed values: none | test.
# "test" is rejected when NODE_ENV=production.
PAYMENT_GATEWAY=none
SMS_PROVIDER=none
SUPPLIER_ADAPTERS=none

# Late-payment HANDLING window (seconds) — approved policy parameter (D9), initial value 300.
# It does NOT extend reservation TTL and never permits using an expired reservation or
# delivering without a (new) reservation. Operational use is specified in the 2b-8 step plan.
LATE_PAYMENT_HANDLING_WINDOW_SECONDS=300

# Key management (KEK / HMAC pepper) is intentionally NOT defined here yet: custody method is
# undecided (D8). A KeyProvider and its variables are added in Phase 2b/2d after approval.
